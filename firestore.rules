rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User favorites collection
    match /users/{userId}/favorites/{favoriteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(favoriteId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() <= 128
                    && request.resource.data.itemType in ['video', 'blog', 'track', 'podcast']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 300;
      allow delete: if isOwner(userId);
    }
  }
}
